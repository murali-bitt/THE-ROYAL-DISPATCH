/**
 * Generates supabase/seed.sql from lib/data/seed.ts so the local demo and the
 * Supabase database are seeded from exactly the same records.
 *
 *   npm run db:seed-sql
 */
import { writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import {
  SEED_ANNOUNCEMENTS,
  SEED_ARTIFACTS,
  SEED_INCIDENTS,
  SEED_INITIATIVES,
  SEED_VILLAGES,
  seedIncidentId,
} from "../lib/data/seed.ts";

const q = (value: string | null) => (value === null ? "null" : `'${value.replace(/'/g, "''")}'`);
const ago = (minutes: number) => `now() - interval '${Math.round(minutes)} minutes'`;
const arr = (values: string[]) =>
  values.length ? `array[${values.map(q).join(", ")}]::text[]` : `'{}'::text[]`;
const ref = (sequence: number) =>
  `'KNG-' || to_char(now(), 'YYYY') || '-${String(sequence).padStart(4, "0")}'`;

const lines: string[] = [
  "-- GENERATED by scripts/generate-seed-sql.mts from lib/data/seed.ts. Do not edit by hand.",
  "-- Fictional demo content for The Royal Dispatch.",
  "begin;",
  "",
];

for (const v of SEED_VILLAGES) {
  const updated = Math.min(...v.log.map((l) => l.ago));
  lines.push(
    `insert into public.villages (id, name, epithet, description, condition, services, restoration, map_x, map_y, updated_at) values (${q(v.id)}, ${q(v.name)}, ${q(v.epithet)}, ${q(v.description)}, ${q(v.condition)}, ${q(JSON.stringify(v.services))}::jsonb, ${v.restoration}, ${v.map.x}, ${v.map.y}, ${ago(updated)});`,
  );
  for (const entry of v.log) {
    lines.push(
      `insert into public.village_updates (village_id, message, author_name, restoration, created_at) values (${q(v.id)}, ${q(entry.message)}, ${q(entry.authorName)}, ${entry.restoration}, ${ago(entry.ago)});`,
    );
  }
}
lines.push("");

for (const inc of SEED_INCIDENTS) {
  let status = "submitted";
  let team: string | null = null;
  for (const e of inc.events) {
    if (e.to) status = e.to;
    if (e.team) team = e.team;
  }
  const first = inc.events[0].ago;
  const last = inc.events[inc.events.length - 1].ago;
  const id = seedIncidentId(inc.sequence);
  lines.push(
    `insert into public.incidents (id, reference, title, description, category, severity, village_id, location, status, anonymous, reporter_name, assigned_team, submitted_at, updated_at) values (${q(id)}, ${ref(inc.sequence)}, ${q(inc.title)}, ${q(inc.description)}, ${q(inc.category)}, ${q(inc.severity)}, ${q(inc.villageId)}, ${q(inc.location)}, ${q(status)}, ${inc.reporter.anonymous}, ${q(inc.reporter.name)}, ${q(team)}, ${ago(first)}, ${ago(last)});`,
  );
  let from = "submitted";
  for (const e of inc.events) {
    const fromStatus = e.to ? q(from) : "null";
    const toStatus = e.to ? q(e.to) : "null";
    if (e.to) from = e.to;
    lines.push(
      `insert into public.incident_updates (incident_id, kind, message, author_name, author_role, from_status, to_status, created_at) values (${q(id)}, ${q(e.kind)}, ${q(e.message)}, ${q(e.authorName)}, ${q(e.authorRole)}, ${fromStatus}, ${toStatus}, ${ago(e.ago)});`,
    );
  }
}
lines.push("");

for (const a of SEED_ANNOUNCEMENTS) {
  lines.push(
    `insert into public.announcements (id, title, summary, body, priority, category, village_id, issued_by, published_at, state) values (${q(a.id)}, ${q(a.title)}, ${q(a.summary)}, ${q(a.body)}, ${q(a.priority)}, ${q(a.category)}, ${q(a.villageId)}, ${q(a.issuedBy)}, ${ago(a.ago)}, ${q(a.state)});`,
  );
}
lines.push("");

for (const i of SEED_INITIATIVES) {
  lines.push(
    `insert into public.initiatives (id, title, summary, village_id, lead, incident_ids, next_steps) values (${q(i.id)}, ${q(i.title)}, ${q(i.summary)}, ${q(i.villageId)}, ${q(i.lead)}, ${arr(i.incidentSequences.map(seedIncidentId))}, ${arr(i.nextSteps)});`,
  );
  i.milestones.forEach((m, position) => {
    lines.push(
      `insert into public.initiative_milestones (id, initiative_id, title, position, done, done_at) values (${q(m.id)}, ${q(i.id)}, ${q(m.title)}, ${position}, ${m.doneAgo !== null}, ${m.doneAgo !== null ? ago(m.doneAgo) : "null"});`,
    );
  });
  for (const u of i.updates) {
    lines.push(
      `insert into public.initiative_updates (initiative_id, message, author_name, created_at) values (${q(i.id)}, ${q(u.message)}, ${q(u.authorName)}, ${ago(u.ago)});`,
    );
  }
}
lines.push("");

for (const a of SEED_ARTIFACTS) {
  lines.push(
    `insert into public.artifacts (id, name, epithet, glyph, origin, description, lore, disaster, containment, village_id, incident_ids) values (${q(a.id)}, ${q(a.name)}, ${q(a.epithet)}, ${q(a.glyph)}, ${q(a.origin)}, ${q(a.description)}, ${q(a.lore)}, ${q(a.disaster)}, ${q(a.containment)}, ${q(a.villageId)}, ${arr(a.incidentSequences.map(seedIncidentId))});`,
  );
}

const maxSequence = Math.max(...SEED_INCIDENTS.map((i) => i.sequence));
lines.push("");
lines.push(`select setval('public.incident_reference_seq', ${maxSequence}, true);`);
lines.push("commit;", "");

const target = fileURLToPath(new URL("../supabase/seed.sql", import.meta.url));
writeFileSync(target, lines.join("\n"));
console.log(`Wrote ${target}`);
