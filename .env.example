# The Royal Dispatch — environment variables
#
# Leave these EMPTY to run in local demo mode: every feature works, records are
# stored in the browser, and a DEMO ROLE SWITCHER appears bottom-left.
#
# Fill both to use Supabase (PostgreSQL + Auth + RLS). Copy this file to
# .env.local first. Only the publishable/anon key is used — the app never needs,
# and must never be given, a service-role key.

# https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API → publishable key (or the legacy "anon" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
